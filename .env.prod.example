# Production settings. Copy to /opt/fundamental-agents/.env.prod on the server
# (mode 600) and fill in. Never commit the real file.
#
# The deploy appends IMAGE_TAG=<commit sha> to this file, so the running
# version survives a reboot.

# --- Where the site lives ---
# The hostname Caddy serves and gets a certificate for. No scheme.
SITE_ADDRESS=example.com
# The site's origin. Links in emails and Stripe return URLs are built from it.
FRONTEND_URL=https://example.com

# --- Secrets ---
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Letters and digits only (it is placed inside a URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Market data and news ---
FINANCIAL_MODELING_PREP_API_KEY=
NEWS_API_KEY=

# --- Stripe ---
# Test keys until the go-live checklist is done. The webhook endpoint is
# https://<SITE_ADDRESS>/api/v1/stripe/webhook
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_PRICE_ID=
# Set to true only with live keys, at the end of the go-live checklist. The
# app refuses to start if this and the key disagree.
STRIPE_LIVE=false

# --- Accounts ---
# Comma-separated addresses that always get premium. Set it explicitly.
PREMIUM_EMAILS=
FREE_TIER_DAILY_ANALYSES=3
RATE_LIMIT_PER_MINUTE=30

# --- Email (optional) ---
# Unset, no email is sent. An account can be verified by hand on the server:
#   docker compose ... exec api python -m app.manage verify <email>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_NAME=StockAnalyzer AI
EMAILS_FROM_ADDRESS=

# --- Off-box backups (optional, strongly recommended) ---
# Nightly dumps are kept on the server either way. With these set, each one is
# also copied to S3-compatible storage (Cloudflare R2's free tier is enough).
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PROVIDER=Cloudflare   # or AWS, Backblaze, Other

# --- Optional ---
LOG_LEVEL=INFO
# Enables the written summary at the top of each report.
ANTHROPIC_API_KEY=
# Error tracking. Unset means off.
SENTRY_DSN=
# Not needed with one API process: the cache is in-process and the queue is
# in Postgres.
REDIS_URL=
