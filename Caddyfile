# ── Caddy Reverse Proxy Configuration ────────────────────────
# Replace yourdomain.com with your actual domain.
# Caddy automatically provisions TLS certificates via Let's Encrypt.

yourdomain.com {
    # Frontend
    reverse_proxy frontend:3000

    # Security headers (Caddy adds most by default)
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
}

api.yourdomain.com {
    # Backend API.
    #
    # Caddy sets X-Forwarded-For/Proto/Host on reverse_proxy by default. The
    # backend only honours them when started with --forwarded-allow-ips (see
    # docker-compose.prod.yml); without that flag it sees this container's
    # address as the client for every request and rate limiting breaks.
    reverse_proxy backend:8000

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
    }
}
